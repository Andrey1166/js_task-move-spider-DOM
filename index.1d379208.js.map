"use strict";
var wall = document.querySelector(".wall");
var spider = document.querySelector(".spider");
wall.addEventListener("click", function(e) {
    var wallCoords = wall.getBoundingClientRect();
    var coordX = e.clientX - wallCoords.left - spider.clientWidth / 2 - wall.clientLeft;
    var coordY = e.clientY - wallCoords.top - spider.clientHeight / 2 - wall.clientTop;
    coordX = Math.max(0, Math.min(coordX, wall.clientWidth - spider.clientWidth));
    coordY = Math.max(0, Math.min(coordY, wall.clientHeight - spider.clientHeight));
    spider.style.left = coordX + "px";
    spider.style.top = coordY + "px";
});

